# Copy this file to .env and fill in your own token.
HF_TOKEN=hf_your_token_here

# Optional: AI summary. Leave empty to use the local heuristic summary.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# Optional: local server and transcription settings.
HOST=127.0.0.1
PORT=8888
WHISPERX_MODEL=large-v3
WHISPERX_DEVICE=cpu
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
